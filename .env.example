H3_INFERENCE_MODE=mock
H3_MODEL_ID=MiniMaxAI/MiniMax-H3
H3_REQUIRE_LOCAL_MODEL=true
# auto selects the official Flash Attention 3 Hub kernel on H100/H200 GPUs.
H3_ATTENTION_BACKEND=auto
# Base endpoint: t2va,fl2va. Reference endpoint: ref2va.
H3_ALLOWED_MODES=t2va,fl2va
HF_HOME=/runpod-volume/huggingface
HF_HUB_CACHE=/runpod-volume/huggingface/hub
HF_XET_CACHE=/runpod-volume/huggingface/xet
H3_OUTPUT_DIR=/tmp/h3-outputs
MAX_REFERENCE_BYTES=314572800
OUTPUT_URL_TTL=604800

# Optional fallback for direct worker use. H3 Studio normally sends a signed,
# per-job upload URL and does not expose these credentials to the worker.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
